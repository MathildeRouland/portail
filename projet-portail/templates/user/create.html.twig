{% extends 'base.html.twig' %}

{% block title %} Créer un utilisateur {% endblock %}

{% block body %}
<h1>Créer un utilisateur</h1>

{{ form_start(form) }}
    {# Ajout explicite du token CSRF en plus du token automatique de Symfony #}
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('create_user') }}">
    
    <div class="form-group">
        {{ form_label(form.username) }}
        {{ form_widget(form.username) }}
        {{ form_errors(form.username, {'attr': {'class': 'form-error'}}) }}
    </div>
    
    <div class="form-group">
        {{ form_label(form.email) }}
        {{ form_widget(form.email) }}
        {{ form_errors(form.email, {'attr': {'class': 'form-error'}}) }}
    </div>
    
    <div class="form-group">
        {{ form_label(form.password) }}
        {{ form_widget(form.password) }}
        {{ form_errors(form.password, {'attr': {'class': 'form-error'}}) }}
    </div>
    
    <div class="form-group">
        {{ form_label(form.roles) }}
        {{ form_widget(form.roles) }}
        {{ form_errors(form.roles, {'attr': {'class': 'form-error'}}) }}
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Créer</button>
    </div>
{{ form_end(form, {'render_rest': true}) }}
{% endblock %}
