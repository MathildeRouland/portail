{% extends 'base.html.twig' %}

{% block body %}
<h2>Changer mon mot de passe</h2>

{{ form_start(form) }}
    {{ form_row(form.currentPassword) }}
    {{ form_row(form.newPassword.first) }}
    {{ form_row(form.newPassword.second) }}

    <button class="btn">Mettre à jour</button>
{{ form_end(form) }}
{% endblock %}