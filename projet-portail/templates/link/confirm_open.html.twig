{% extends 'base.html.twig' %}
{% block title %}lien valide{% endblock %}

{% block body %}
<h2>Ouverture du portail</h2>
{% if error is defined and error %}
    <div id="rgpdErrorServer" style="color:red; margin-bottom:10px;">
        {{ error }}
    </div>
{% endif %}
{% if portalText %}
    <div style="margin-bottom: 15px;">
        {{ portalText|raw }}
    </div>
{% endif %}

<p>Nom du client : <strong>{{ link.customerName }}</strong></p>

<form id="openPortalForm" action="{{ path('link_open_validate', { fullUrl: fullUrl }) }}" method="post">

    <!-- Case à cocher RGPD -->
    <div style="margin-bottom: 10px;">
        <input type="checkbox" id="rgpdConsent" name="rgpdConsent" />
        <label for="rgpdConsent">
            J'accepte les <a href="{{ rgpdFile ? asset('uploads/' ~ rgpdFile) : '#' }}" id="rgpdLink" target="_blank">
                conditions du Règlement de Gestion de la Protection des Données
            </a>
        </label>
    </div>

    <!-- ICI tu ajoutes le message -->
    <div id="rgpdError" style="display:none; color:red; margin-top:10px;">
        Vous devez accepter les conditions RGPD pour continuer.
    </div>

    <button type="submit" id="openPortalBtn" disabled>Ouvrir le portail</button>
</form>

<div id="loadingMessage" style="display:none; margin-top: 10px; color: #333;">
    Portail en cours d'ouverture...
</div>

<script>
const form = document.getElementById('openPortalForm');
const loading = document.getElementById('loadingMessage');
const consent = document.getElementById('rgpdConsent');
const submitBtn = document.getElementById('openPortalBtn');

// activer le bouton seulement si la case est cochée
consent.addEventListener('change', function() {
    submitBtn.disabled = !this.checked;
});

// afficher message de chargement avant soumission
// interception submit
  // bouton état initial
    submitBtn.disabled = !consent.checked;

    consent.addEventListener('change', function () {
        submitBtn.disabled = !this.checked;
        error.style.display = 'none';
    });

    form.addEventListener('submit', function (event) {

        if (!consent.checked) {
            event.preventDefault();
            error.style.display = 'block';
            return;
        }

        // IMPORTANT: ne pas bloquer si OK
        loading.style.display = 'block';
    });
</script>

{% endblock %}
