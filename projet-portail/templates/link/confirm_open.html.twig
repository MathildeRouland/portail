
{% extends 'base.html.twig' %}
{% block title %}lien valide{% endblock %}

{% block body %}
<h2>Ouverture du portail</h2>

<p>Nom du client : <strong>{{ link.customerName }}</strong></p>

<form id="openPortalForm" action="{{ path('link_open_validate', { fullUrl: fullUrl }) }}" method="post">
    <button type="submit">Ouvrir le portail</button>
</form>

<div id="loadingMessage" style="display:none; margin-top: 10px; color: #333;">
    Portail en cours d'ouverture...
</div>

<script>
const form = document.getElementById('openPortalForm');
const loading = document.getElementById('loadingMessage');

form.addEventListener('submit', function(event) {
    event.preventDefault(); // empêche la soumission immédiate
    loading.style.display = 'block'; // affiche le message

    // soumission du formulaire après un très court délai pour que le message s'affiche
    setTimeout(() => {
        form.submit();
    }, 50); // 50ms suffisent
});
</script>

{% endblock %}