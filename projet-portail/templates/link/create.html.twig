{% block title %}Créer un lien{% endblock %}

{% block body %}
<h1>Créer un lien</h1>

<form action="{{ path('link_create') }}" method="POST">
    {{ form_start(form) }}

    {{ form_row(form.customerName) }}
    {{ form_row(form.startDate) }}
    {{ form_row(form.endDate) }}
    {{ form_row(form.customerPhoneNumber) }}
    {{ form_row(form.customerEmail) }}

    {# Afficher le lien généré avant l'envoi #}
    <div>
        <strong>Lien généré : </strong>
        <span>{{ generated_link }}</span>
    </div>

    <button type="submit">Créer le lien</button>
    
    {{ form_end(form) }}
</form>

{% endblock %}