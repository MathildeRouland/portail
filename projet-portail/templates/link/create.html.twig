{% extends 'base.html.twig' %}
{% block title %}Créer un lien{% endblock %}

{% block body %}
<h1>Créer un lien</h1>

{{ form_start(form) }}

<div class="form-group">
    {{ form_label(form.customerName) }}
    {{ form_widget(form.customerName) }}
    {{ form_errors(form.customerName, {'attr': {'class': 'form-error'}}) }}
</div>
<div class="form-group">
    {{ form_label(form.startDate) }}
    {{ form_widget(form.startDate) }}
    {{ form_errors(form.startDate, {'attr': {'class': 'form-error'}}) }}
</div>
<div class="form-group">
    {{ form_label(form.endDate) }}
    {{ form_widget(form.endDate) }}
    {{ form_errors(form.endDate, {'attr': {'class': 'form-error'}}) }}
</div>
<div class="form-group">
    {{ form_label(form.customerPhoneNumber) }}
    {{ form_widget(form.customerPhoneNumber) }}
    {{ form_errors(form.customerPhoneNumber, {'attr': {'class': 'form-error'}}) }}
</div>
<div class="form-group">
    {{ form_label(form.customerEmail) }}
    {{ form_widget(form.customerEmail) }}
    {{ form_errors(form.customerEmail, {'attr': {'class': 'form-error'}}) }}
</div>
<div class="form-group">
    {{ form_label(form.createdAt) }}
    {{ form_widget(form.createdAt) }}
    {{ form_errors(form.createdAt, {'attr': {'class': 'form-error'}}) }}
</div>
<div class="form-group">
    {{ form_label(form.updatedAt) }}
    {{ form_widget(form.updatedAt) }}
    {{ form_errors(form.updatedAt, {'attr': {'class': 'form-error'}}) }}
</div>
<div class="form-group">
    {{ form_label(form.creator) }}
    {{ form_widget(form.creator) }}
    {{ form_errors(form.creator, {'attr': {'class': 'form-error'}}) }}
</div>
<div class="form-group">
    {{ form_label(form.updater) }}
    {{ form_widget(form.updater) }}
    {{ form_errors(form.updater, {'attr': {'class': 'form-error'}}) }}
</div>

    {# Afficher le lien généré avant l'envoi #}
    <div>
        <strong>Lien généré : </strong>
        <span>{{ generated_link }}</span>
    </div>

    <button type="submit" class="btn btn-primary">Créer le lien</button>
    
{{ form_end(form) }}

{% endblock %}