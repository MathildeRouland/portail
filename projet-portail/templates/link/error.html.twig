{% extends "base.html.twig" %}

{% block title %}Erreur d'accès{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Erreur système</h4>
                <p>{{ message }}</p>
                <hr>
                <p class="mb-0">L'administrateur a été notifié. Veuillez réessayer plus tard ou contacter le support.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
