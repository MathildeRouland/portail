{% extends 'base.html.twig' %}

{% block title %} Liste de mes liens {% endblock %}

{% block body %}
    <h1>
        {% if is_granted('ROLE_SUPER_ADMIN') %}
            Liste de tous les liens
        {% else %}
            Liste de mes liens
        {% endif %}
    </h1>

    {% if links is empty %}
        <p>Aucun lien n'a été créé pour le moment.</p>
    {% else %}
    <div class="table-container">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Identifiant</th>                    
                    <th>URL</th>
                    <th>Usager</th>
                    <th>Email</th>
                    <th>téléphone</th>
                    <th>Date de début</th>
                    <th>Date de fin</th>
                    <th>Statut</th>
                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                        <th>Créateur</th>
                        <th>Date de création</th>
                        <th>Modifié par</th>
                        <th>Date de modification</th>
                    {% endif %}
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for link in links %}
                    <tr>
                        <td data-label="Identifiant :">{{ link.id }}</td>
                        <td>
                            <a href="{{ link.url }}" target="_blank">
                                {{ link.url }}
                            </a>
                        </td>
                        <td data-label="Nom de l'usager  :">{{ link.customerName }}</td>
                        <td data-label="Email  :">{{ link.customerEmail }}</td>
                        <td data-label="Téléphone  :">{{ link.customerPhonenumber }}</td>
                        <td data-label="Date de début :">{{ link.startDate ? link.startDate|date('d/m/Y H:i') : 'Non défini' }}</td>
                        <td data-label="Date de fin :">{{ link.endDate ? link.endDate|date('d/m/Y H:i') : 'Non défini' }}</td>
                        <td data-label="Statut :">
                                        {% if link.isCurrentlyActive %}
                                            <span style="color:green;">Actif</span>
                                        {% else %}
                                            <span style="color:red;">Inactif</span>
                                        {% endif %}
                                    </td>
                        </td>
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <td data-label="Créateur :">{{ link.creator.username }}</td>
                            <td data-label="Créé le :">{{ link.createdAt|date('d/m/Y H:i') }}</td>
                            <td data-label="Modifié par :">{{ link.updater.username }}</td>
                            <td data-label="Modifié le :">{{ link.updatedAt|date('d/m/Y H:i') }}</td>
                        {% endif %}
                        <td>
                        <div class="action-btns">        
                                <form method="post" action="{{ path('link_edit', {'id': link.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('update-link-' ~ link.id) }}">
                                    <button type="submit" class="btn-action btn-primary">Modifier</button>
                                </form>

                                <form method="post" action="{{ path('link_delete', {'id': link.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce lien ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-link-' ~ link.id) }}">
                                    <button type="submit" class="btn-action btn-danger">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
{% endblock %}