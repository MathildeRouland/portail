{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
<h1>{{ page_title }}</h1>

<p>Ici, vous pouvez modifier l'apparence du portail.</p>

{{ form_start(form) }}

<p>Texte de la page d'accueil:</p>

    {{ form_row(form.homepageText) }}

<p>Image de fond de la page d'accueil:</p>
    {{ form_row(form.backgroundImage) }}

    <button class="btn btn-primary">Enregistrer</button>

{{ form_end(form) }}

{% endblock %}